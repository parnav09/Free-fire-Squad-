    "test:evolution-phase-two-2": "node --test scripts/verify-evolution-phase-two-2.mjs",
    "test:evolution-phase-two-3": "node --test scripts/verify-evolution-phase-two-3.mjs",
    "test:evolution-phase-two-4": "node --test scripts/verify-evolution-phase-two-4.mjs",
    "test:evolution-phase-two-5": "node --test scripts/verify-evolution-phase-two-5.mjs",
    "test:evolution-phase-two-6": "node --test scripts/verify-evolution-phase-two-6.mjs",
